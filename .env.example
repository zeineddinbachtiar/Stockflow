
NODE_ENV=development
PORT=3000
# Comma-separated frontend origins (without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Number of trusted reverse-proxy hops.
# Keep 0 unless the deployment proxy topology is known.
TRUST_PROXY_HOPS=0

DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockflow_db
DB_USER=stockflow_app
DB_PASSWORD=
# Local Docker PostgreSQL administrator password.
# Must be different from DB_PASSWORD.
POSTGRES_ADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_WAREHOUSE_PASSWORD=
SEED_SALES_PASSWORD=
JWT_SECRET=